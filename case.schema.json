{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/open-energy-transition/PyPSA-X/case.schema.json",
  "title": "PyPSA-X case definition (case.yaml)",
  "description": "Settings, assumptions, scenarios and time-series mapping of a PyPSA-X case folder. Replaces the Excel assumption book. Tables live next to it: technologies.csv, network/*.csv, timeseries/profiles.csv.",
  "type": "object",
  "additionalProperties": false,
  "required": ["settings", "assumptions"],
  "properties": {
    "settings": { "$ref": "#/$defs/settings" },
    "assumptions": { "$ref": "#/$defs/assumptions" },
    "scenarios": {
      "description": "Scenario changes (former sheet 'scen_params'). If settings.scenarios.run_all is false, only the first active scenario is run.",
      "$ref": "#/$defs/scenarioBlock"
    },
    "stochastic": {
      "description": "Stochastic case changes (former sheet 'stoch_params'). Case names should match settings.stochastic.cases.",
      "$ref": "#/$defs/scenarioBlock"
    },
    "timeseries": { "$ref": "#/$defs/timeseries" }
  },
  "$defs": {
    "scalar": { "type": ["number", "string", "boolean"] },
    "numberOrInf": {
      "description": "Number, or the text 'inf' / '-inf'.",
      "anyOf": [{ "type": "number" }, { "type": "string", "enum": ["inf", "-inf"] }]
    },
    "share": { "type": "number", "minimum": 0, "maximum": 1 },
    "year": { "type": "integer", "minimum": 1900, "maximum": 2200 },
    "nonEmptyString": { "type": "string", "minLength": 1 },

    "settings": {
      "description": "Optimization settings (former sheet 'opt_params'). Anything left out uses the default in pypsa-x.py.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "debug": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "description": "Limit the optimization to 'hours_to_optimize' hours." },
            "hours_to_optimize": { "type": "integer", "minimum": 1, "description": "Number of hours optimized in debug mode." }
          }
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "target_folder": { "$ref": "#/$defs/nonEmptyString", "description": "Folder for temporary and result files, e.g. run_1." },
            "csv_subfolder": { "$ref": "#/$defs/nonEmptyString", "description": "Subfolder (in target_folder) for the resolved PyPSA CSV tables." },
            "temp_file": { "type": "string", "pattern": "\\.nc$", "description": "File name of the base network, e.g. base_model.nc." },
            "result_file": { "$ref": "#/$defs/nonEmptyString", "description": "Prefix of the result NC files, e.g. result." }
          }
        },
        "compute": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "use_oetc": { "type": "boolean", "description": "Solve on the OET cluster (OETC)." }
          }
        },
        "segmentation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "description": "Reduce the time resolution before optimizing." },
            "function": { "enum": ["resample", "downsample", "segment"], "description": "Time aggregation method." },
            "hours": { "type": "integer", "minimum": 1, "description": "Resampling length in hours, or number of segments." }
          }
        },
        "scenarios": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "run_all": { "type": "boolean", "description": "Run all active scenarios; if false only the first active one." }
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "modular_representation": { "type": "boolean", "description": "Represent individual modules/units." },
            "transmission_losses": { "type": "integer", "minimum": 0, "description": "Number of tangents for the piecewise-linear loss approximation; 0 = no losses." },
            "remove_kvl_constraints": { "type": "boolean", "description": "Drop the KVL constraints." }
          }
        },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "investment": { "type": "boolean", "description": "Capacity/investment related constraints (e.g. linked capacities)." },
            "operational": { "type": "boolean", "description": "Operation related constraints." },
            "milp": { "type": "boolean", "description": "MILP constraints (e.g. minimum load if in operation, invest if installed)." },
            "strict_unsimultaneous_dis_charging": { "type": "boolean", "description": "Forbid simultaneous charging and discharging (binary)." },
            "maintenance": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean", "description": "Enable maintenance planning." },
                "mode": { "enum": ["hourly", "daily", "weekly", "monthly"], "description": "When maintenance can start." }
              }
            }
          }
        },
        "duals": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "assign_all": { "type": "boolean", "description": "Assign all duals after solving." }
          }
        },
        "small_limit": { "type": "number", "minimum": 0, "description": "Smallest capacity treated as a built technology, e.g. 1.0e-05." },
        "economics": {
          "description": "Normally left out: derived from 'assumptions'.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "discount_factor": { "type": "number", "description": "Default: assumptions annuity factor." },
            "years_of_construction": { "type": "integer", "minimum": 0, "description": "Default: y_cod - y_ntp." },
            "project_cod": { "$ref": "#/$defs/year", "description": "Default: y_cod." },
            "years_of_operation": { "type": "integer", "minimum": 1, "description": "Default: project_lifetime." }
          }
        },
        "solver": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mipgap": { "type": "number", "minimum": 0, "description": "Relative MIP gap, e.g. 0.0001." },
            "timelimit_hours": { "type": "number", "exclusiveMinimum": 0, "description": "Solver time limit in hours." },
            "log_to_console": { "enum": [0, 1], "description": "Solver output to the console." },
            "output_flag": { "enum": [0, 1], "description": "Solver output to the log file." }
          }
        },
        "stochastic": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "description": "Run an additional stochastic optimization." },
            "alpha": { "$ref": "#/$defs/share", "description": "CVaR alpha." },
            "omega": { "$ref": "#/$defs/share", "description": "CVaR weight omega." },
            "cases": {
              "description": "Stochastic cases and their probabilities, e.g. {P50: 1.0}.",
              "type": "object",
              "minProperties": 1,
              "additionalProperties": { "$ref": "#/$defs/share" }
            }
          }
        },
        "mga": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "description": "Run additional MGA (modelling to generate alternatives) runs." },
            "slack": { "type": "number", "minimum": 0 },
            "slacks": { "type": "array", "items": { "type": "number", "minimum": 0 } }
          }
        },
        "rolling_horizon": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "description": "Run rolling horizon after the optimization." },
            "horizon": { "type": "integer", "minimum": 1, "description": "Horizon length in hours." },
            "overlap": { "type": "integer", "minimum": 0, "description": "Overlap in hours." }
          }
        },
        "security_constrained": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "description": "Run a security-constrained optimization after the optimization." }
          }
        },
        "investment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "periods": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/year" }, "description": "Years to optimize. Default: [y_cod]." },
            "weighting": { "type": "array", "minItems": 1, "items": { "type": "number", "exclusiveMinimum": 0 }, "description": "Weight of each period, e.g. [5, 5, 10]." },
            "primary_optimization": { "enum": ["pathway", "myopic"] },
            "objective_function": { "enum": ["annuity+o&m", "npv"] }
          }
        },
        "nminus1": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "description": "Activate N-1 constraints." }
          }
        },
        "cfe": {
          "description": "Hourly (carbon-free energy) matching.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "matching": { "$ref": "#/$defs/share", "description": "Required matching share; 0 = off." },
            "type": { "enum": ["hour", "day", "week", "month", "year", "total"], "description": "Matching period." },
            "renewables": { "type": "array", "items": { "type": "string" }, "description": "Carriers counted as renewable." }
          }
        },
        "reserve_margin": {
          "description": "Reserve margin: a * ((b * load + c**2) ** d) - e.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "factors": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "a": { "type": "number" },
                "b": { "type": "number" },
                "c": { "type": "number" },
                "d": { "type": "number" },
                "e": { "type": "number" }
              }
            },
            "max_generator": { "type": "boolean", "description": "Also cover the largest installed generator." },
            "load": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "class": { "$ref": "#/$defs/nonEmptyString", "description": "Component class of the load, e.g. Load." },
                "name": { "$ref": "#/$defs/nonEmptyString", "description": "Name of the load, e.g. LOAD_EL_01." }
              }
            }
          }
        }
      }
    },

    "assumptions": {
      "description": "Economic and project assumptions (former sheet 'AB', upper block). WACC, annuity factor, equity share, end year, construction period and hourly production target are derived. Extra keys (custom variables) are allowed and can be used as 'scale' in timeseries.",
      "type": "object",
      "required": [
        "y_base", "y_ntp", "y_cod", "project_lifetime",
        "inflation", "interest_nominal", "cost_of_equity_nominal", "debt_share", "corporate_tax", "financial_term",
        "project_name", "project_location", "project_country", "currency",
        "plant_availability", "production_product", "production_target_year", "production_supply_frequency"
      ],
      "properties": {
        "y_base": { "$ref": "#/$defs/year", "description": "Base year of e.g. cost assumptions." },
        "y_ntp": { "$ref": "#/$defs/year", "description": "Planned notice to proceed (NTP)." },
        "y_cod": { "$ref": "#/$defs/year", "description": "Planned commercial operation date (COD)." },
        "project_lifetime": { "type": "integer", "minimum": 1, "description": "Years." },
        "inflation": { "type": "number", "minimum": -1, "maximum": 1 },
        "interest_nominal": { "type": "number", "minimum": -1, "maximum": 1 },
        "cost_of_equity_nominal": { "type": "number", "minimum": -1, "maximum": 1 },
        "debt_share": { "$ref": "#/$defs/share" },
        "corporate_tax": { "$ref": "#/$defs/share" },
        "financial_term": { "enum": ["real", "nominal"], "description": "Basis of the annuity calculation." },
        "project_name": { "type": "string" },
        "project_location": { "type": "string" },
        "project_country": { "type": "string" },
        "currency": { "type": "string", "minLength": 1, "description": "Model currency, e.g. EUR." },
        "plant_availability": { "$ref": "#/$defs/share" },
        "plant_availability_adjustment": { "type": "boolean", "description": "Divide the hourly production target by the plant availability." },
        "production_product": { "type": "string", "description": "Carrier of the load that gets the production target." },
        "production_target_year": { "type": "number", "minimum": 0, "description": "Annual production target (unit of the product carrier)." },
        "production_supply_frequency": {
          "enum": ["constant", "monthly", "quarterly", "half-annual", "annual", "weekly", "random"],
          "description": "Shape of the generated Supply_Mode profile (used if profiles.csv has no Supply_Mode column)."
        }
      },
      "additionalProperties": { "$ref": "#/$defs/scalar" }
    },

    "componentClass": {
      "enum": ["Generator", "Link", "Store", "StorageUnit", "Line", "Transformer", "Load", "Bus", "Carrier", "ShuntImpedance", "GlobalConstraint"]
    },
    "setChanges": {
      "description": "{Python: {<setting>: <value>}} and/or {<Class>: {<name>: {<attribute>: <value>}}}.",
      "type": "object",
      "properties": {
        "Python": {
          "description": "Settings changed for this scenario, using the legacy setting names (e.g. transmission_losses).",
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/scalar" }
        }
      },
      "propertyNames": { "anyOf": [{ "const": "Python" }, { "$ref": "#/$defs/componentClass" }] },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/scalar" }
        }
      }
    },
    "delChanges": {
      "description": "{<Class>: [<name>, ...]} removes components; {<Class>: {<name>: {<column>: <value>}}} zeroes a column (stochastic cases).",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/componentClass" },
      "additionalProperties": {
        "oneOf": [
          { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          {
            "type": "object",
            "additionalProperties": {
              "type": ["object", "null"],
              "additionalProperties": { "$ref": "#/$defs/scalar" }
            }
          }
        ]
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "active": { "type": "boolean", "default": true },
        "set": { "$ref": "#/$defs/setChanges" },
        "del": { "$ref": "#/$defs/delChanges" },
        "inactive": {
          "description": "Switched-off changes, kept for reference.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "set": { "$ref": "#/$defs/setChanges" },
            "del": { "$ref": "#/$defs/delChanges" }
          }
        }
      }
    },
    "scenarioBlock": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/scenario" }
    },

    "timeseries": {
      "description": "Mapping of raw profiles (timeseries/profiles.csv) to PyPSA time-varying attributes.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "random_seed": { "type": "integer", "description": "Seed for a generated 'random' Supply_Mode profile." },
        "snapshot_weightings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "objective": { "type": "number", "minimum": 0 },
            "stores": { "type": "number", "minimum": 0 },
            "generators": { "type": "number", "minimum": 0 }
          }
        },
        "series": {
          "description": "<table>-<attribute> (e.g. generators-p_max_pu) -> {<component name>: rule}.",
          "type": "object",
          "propertyNames": {
            "pattern": "^(generators|links|stores|storage_units|loads|lines|transformers|buses)-[A-Za-z0-9_]+$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": { "$ref": "#/$defs/seriesRule" }
          }
        }
      }
    },
    "seriesRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": { "type": "string", "description": "Column in profiles.csv." },
        "constant": { "type": "number" },
        "scale": {
          "description": "Factor: a number or the name of an assumption (e.g. production_target_hour).",
          "type": ["number", "string"]
        }
      },
      "oneOf": [{ "required": ["profile"] }, { "required": ["constant"] }]
    }
  }
}
